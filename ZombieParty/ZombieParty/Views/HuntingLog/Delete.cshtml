@model HuntingLog

<h2 class="text-info">Delete Hunting Log</h2>
<hr />
<form method="post" asp-action="DeletePost">
    <div class="border p-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input asp-for="Id" class="form-control" hidden />
        <div class="form-group row">
            <div class="col-4">
                <label asp-for="Title" class="control-label"></label>
            </div>
            <div class="col-8">
                <input asp-for="Title" class="form-control" disabled />
            </div>
        </div>
        <div class="form-group row">
            <div class="col-4">
                <label asp-for="Description" class="control-label"></label>
            </div>
            <div class="col-8">
                <input asp-for="Description" class="form-control" disabled />
            </div>
        </div>
        <div class="form-group row py-2">
            <div class="col-8 offset-4 row">
                <div class="col">
                    <input type="submit" class="btn btn-danger w-100" value="Delete" />
                </div>
                <div class="col">
                    <a asp-action="Index" class="btn btn-secondary w-100">Back to list</a>
                </div>
            </div>
        </div>
    </div>
</form>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}